# Azure DNS POC Solution Accelerator — .gitignore

# Sensitive files — NEVER commit
*.key
*.pem
*.pfx
*.cer
*connection-string*
*secrets*

# Local zone snapshot exports
snapshot-*.zone
zone-snapshots/

# Bind zone files (customer-provided — contain DNS data)
zone-files/

# Customer-specific engagement docs (not for public repo)
Zava_DNS_POC_Scoping_Session_Agenda.md
Zava_Azure_DNS_POC_Plan.md
Zava_DCV_Walkthrough_Guide.md
DNS_POC_Core Ask from the Customer.txt
DNS_POC_Solution_Accelerator_Discovery.md
Zava DNS POC Scope _3_25_2026.txt
Zava_Azure_DNS_POC_Plan.md

# Backup files
*.bkp
*.bak
*.tmp
~$*

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Editor files
*.swp
*.swo
*~

# PowerShell temp files
*.log

# Generated role definition (contains subscription ID)
dns-operator-role.json

# Internal analysis docs (not for public repo)
DCV_Gap_Analysis.md
