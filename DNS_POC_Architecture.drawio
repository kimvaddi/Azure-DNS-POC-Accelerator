        <!-- ============ OPTIONAL: FRONT DOOR (Bottom) ============ -->
        <mxCell id="afd-optional" value="OPTIONAL: Azure Front Door (Section 11 — Commented Out)&#xa;─────────────────────────────────────────────────────&#xa;AFD Standard SKU → Origin Group → 2 Web App Origins → Route → Custom Domain + Managed TLS&#xa;Layer 7 reverse proxy: caching, WAF, SSL offload, URL routing (vs TM which is DNS-only Layer 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeDasharray=8 4;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#666666;" vertex="1" parent="1">
